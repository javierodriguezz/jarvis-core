# Copia este archivo como ".env" y llena tus propios valores.
# .env nunca se sube a git (ver .gitignore).

# Se usará a partir de la Fase 3 (modelo de lenguaje local vía Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Se usará a partir de la Fase 5 (transcripción de voz con faster-whisper)
WHISPER_MODEL=base

# Se usará a partir de la Fase 6 (síntesis de voz con Piper)
PIPER_VOICE=es_ES-davefx-medium

# Se usará a partir de la Fase 6.5 (preguntas abiertas con Gemini).
# Saca tu propia clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
